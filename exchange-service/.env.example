# Copy these into the backend host's secret environment settings.
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
ZENCRYPTO_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
EXCHANGE_SANDBOX=true
LIVE_TRADING_ENABLED=false
ALLOWED_ORIGINS=https://jacksonmariso02-crypto.github.io
PAPER_ENGINE_DB_PATH=/var/data/zencrypto-paper-engine.sqlite3

# Paper-only risk guardrails (not a substitute for production controls).
PAPER_MAX_ORDER_NOTIONAL=100000
PAPER_ORDER_RATE_LIMIT=30
PAPER_ORDER_RATE_WINDOW_SECONDS=60

# User access tokens. Generate a cryptographically random secret of at least 32 characters.
AUTH_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_TOKEN_TTL_SECONDS=900
AUTH_ATTEMPT_RATE_LIMIT=10
AUTH_ATTEMPT_RATE_WINDOW_SECONDS=300

# Paper trading fee rates, expressed in basis points (100 bps = 1%).
# Defaults: maker 0.10%, taker 0.20%. Set to 0 to disable.
PAPER_MAKER_FEE_BPS=10
PAPER_TAKER_FEE_BPS=20

# Shared external public market-data WebSocket polling interval (minimum 2 seconds).
MARKET_STREAM_INTERVAL_SECONDS=2

# Shared paper order-book snapshot polling interval (minimum 0.25 seconds).
PAPER_BOOK_STREAM_INTERVAL_SECONDS=0.5
