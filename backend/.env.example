# Generate a unique random value; never reuse the example below in a real environment.
APP_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=zencrypto.db
CORS_ORIGINS=http://localhost:5173

# Keep this key only in the backend deployment secret store. Never use a VITE_ prefix.
ZEROX_API_KEY=replace-with-your-0x-api-key

# Keep false in any public/production environment; legacy sandbox endpoints are blocked by default.
ENABLE_PAPER_TRADING=false
